{
	"name": "theuri-kagwi-site",
	"version": "1.0.0",
	"private": true,
	"description": "Personal website of Theuri Kagwi, built with Eleventy.",
	"type": "module",
	"scripts": {
		"build": "npx @11ty/eleventy",
		"build-nocolor": "cross-env NODE_DISABLE_COLORS=1 npx @11ty/eleventy",
		"start": "npx @11ty/eleventy --serve --quiet",
		"debug": "cross-env DEBUG=Eleventy* npx @11ty/eleventy",
		"debugstart": "cross-env DEBUG=Eleventy* npx @11ty/eleventy --serve --quiet",
		"benchmark": "cross-env DEBUG=Eleventy:Benchmark* npx @11ty/eleventy"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kagwicharles/kagwicharles.github.io.git"
	},
	"author": "Theuri Kagwi",
	"license": "MIT",
	"engines": {
		"node": ">=18"
	},
	"bugs": {
		"url": "https://github.com/kagwicharles/kagwicharles.github.io/issues"
	},
	"homepage": "https://kagwicharles.github.io/",
	"devDependencies": {
		"@11ty/eleventy": "^3.1.8",
		"@11ty/eleventy-img": "^7.1.1",
		"@11ty/eleventy-navigation": "^1.0.5",
		"@11ty/eleventy-plugin-rss": "^3.1.0",
		"@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
		"cross-env": "^10.1.0",
		"luxon": "^3.7.2",
		"prismjs": "^1.30.0",
		"zod": "^4.6.7"
	},
	"dependencies": {
		"@zachleat/heading-anchors": "^1.1.0"
	}
}