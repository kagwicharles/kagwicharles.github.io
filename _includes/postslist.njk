<ul class="postlist">
{%- for post in postslist | reverse %}
	<li class="postlist-item{% if post.url == url %} postlist-item-active{% endif %}">
		<time class="postlist-date" datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate("dd LLL yyyy") }}</time>
		<div class="postlist-body">
			<a href="{{ post.url }}" class="postlist-link">{% if post.data.title %}{{ post.data.title }}{% else %}<code>{{ post.url }}</code>{% endif %}</a>
			{%- if post.data.description %}
			<p class="postlist-description">{{ post.data.description }}</p>
			{%- endif %}
			{%- if post.data.tags %}
			<p class="postlist-tags">
				{%- for tag in post.data.tags %}{% if tag != "posts" and tag != "bliki" and tag != "all" %}<a class="post-tag" href="/tags/{{ tag | slugify }}/">{{ tag }}</a>{% endif %}{% endfor %}
			</p>
			{%- endif %}
		</div>
	</li>
{%- endfor %}
</ul>