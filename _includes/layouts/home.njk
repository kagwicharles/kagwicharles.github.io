---
layout: layouts/base.njk
---
{% css %}
	.hero {
		margin: 0 0 2.5rem;
		padding: 2rem 1.5rem;
		background: var(--color-accent-tint);
		border-left: 4px solid var(--color-accent);
	}
	.hero h1 {
		margin: 0 0 .35em;
		font-size: 2.4em;
	}
	.hero-lead {
		max-width: 34em;
		margin: 0 0 1.5em;
		font-size: 1.15em;
	}
	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: .75em;
		margin: 0;
	}
	a.button[href],
	a.button[href]:visited {
		display: inline-block;
		padding: .55em 1.2em;
		background: var(--color-accent);
		border: 2px solid var(--color-accent);
		color: #fff;
		font-weight: 600;
		text-decoration: none;
	}
	a.button[href]:hover {
		background: var(--color-accent-dark);
		border-color: var(--color-accent-dark);
		color: #fff;
	}
	a.button-secondary[href],
	a.button-secondary[href]:visited {
		background: transparent;
		color: var(--color-accent);
	}
	a.button-secondary[href]:hover {
		background: var(--color-accent);
		border-color: var(--color-accent);
		color: #fff;
	}
	.section-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1em;
		margin: 2.5em 0 0;
	}
	.section-head h2 {
		margin: 0;
		font-size: 1.3em;
	}
	.section-head a {
		font-size: .9em;
	}
{% endcss %}

{{ content | safe }}